<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:padding="18dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:id="@+id/examName" android:textStyle="bold" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/saved" android:text="Đáp án đã nạp" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Mã đề:" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/code" android:inputType="number" android:hint="VD: 004" android:layout_width="100dp" android:layout_height="wrap_content"/></LinearLayout>
 <TextView android:text="Đáp án (mỗi dòng gồm A, B, C hoặc D; tối đa 40 dòng)" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/answers" android:gravity="top" android:inputType="textMultiLine|textCapCharacters" android:minLines="12" android:hint="A\nB\nC\nD\n..." android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/saveKey" android:text="LƯU ĐÁP ÁN MÃ ĐỀ" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
